generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  SCHOOL_STAFF
  KITCHEN_MANAGER
  NUTRITIONIST
  WAREHOUSE_STAFF
  PARENT
}

enum StudentStatus {
  ACTIVE
  PAUSED
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum LotStatus {
  AVAILABLE
  QUARANTINED
  EXPIRED
  DEPLETED
}

enum FoodCheckStatus {
  PASS
  FAIL
  NEEDS_REVIEW
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum TraceEventType {
  RECEIVED
  INSPECTED
  STORED
  PREPARED
  COOKED
  SERVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(SCHOOL_STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  schoolId     String?  @map("school_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([schoolId, role])
  @@map("users")
}

model Classroom {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  grade      Int?
  schoolId   String    @map("school_id") @db.Uuid
  schoolYear String?   @map("school_year")
  students   Student[]
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([schoolId, name, schoolYear])
  @@map("classrooms")
}

model Student {
  id               String            @id @default(uuid()) @db.Uuid
  code             String
  name             String
  classroomId      String?           @map("classroom_id") @db.Uuid
  gender           Gender?
  birthDate        DateTime?         @map("birth_date") @db.Date
  guardian         String?
  phone            String?
  status           StudentStatus     @default(ACTIVE)
  schoolId         String            @map("school_id") @db.Uuid
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  classroom        Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  attendanceEvents AttendanceEvent[]

  @@unique([schoolId, code])
  @@index([schoolId, name])
  @@index([classroomId, status])
  @@map("students")
}

model AttendanceEvent {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  studentId         String?  @map("student_id") @db.Uuid
  deviceId          String   @default("hik-main") @map("device_id")
  deviceSerialNo    BigInt   @map("device_serial_no")
  employeeNoString  String   @map("employee_no_string")
  major             Int
  minor             Int
  occurredAt        DateTime @map("occurred_at")
  attendanceStatus  String?  @map("attendance_status")
  currentVerifyMode String?  @map("current_verify_mode")
  createdAt         DateTime @default(now()) @map("created_at")

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceSerialNo])
  @@index([schoolId, occurredAt])
  @@index([schoolId, employeeNoString])
  @@index([studentId, occurredAt])
  @@map("attendance_events")
}

model Supplier {
  id          String         @id @default(uuid()) @db.Uuid
  code        String
  name        String
  taxCode     String?        @map("tax_code")
  contactName String?        @map("contact_name")
  phone       String?
  email       String?
  address     String?
  status      SupplierStatus @default(ACTIVE)
  schoolId    String         @map("school_id") @db.Uuid
  lots        InventoryLot[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([schoolId, code])
  @@index([schoolId, name])
  @@map("suppliers")
}

model Ingredient {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  unit      String
  category  String?
  lots      InventoryLot[]
  createdAt DateTime       @default(now()) @map("created_at")

  @@map("ingredients")
}

model InventoryLot {
  id              String       @id @default(uuid()) @db.Uuid
  lotCode         String       @map("lot_code")
  ingredientId    String       @map("ingredient_id") @db.Uuid
  supplierId      String       @map("supplier_id") @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  quantity        Decimal      @db.Decimal(12, 3)
  remainingQty    Decimal      @map("remaining_qty") @db.Decimal(12, 3)
  unit            String
  receivedAt      DateTime     @default(now()) @map("received_at")
  expiryDate      DateTime?    @map("expiry_date") @db.Date
  storageLocation String?      @map("storage_location")
  status          LotStatus    @default(AVAILABLE)
  supplier        Supplier     @relation(fields: [supplierId], references: [id])
  ingredient      Ingredient   @relation(fields: [ingredientId], references: [id])
  traceEvents     TraceEvent[]

  @@unique([schoolId, lotCode])
  @@index([schoolId, status, expiryDate])
  @@map("inventory_lots")
}

model Dish {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  category      String?
  recipe        Json?
  mealPlanItems MealPlanItem[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("dishes")
}

model MealPlan {
  id          String         @id @default(uuid()) @db.Uuid
  schoolId    String         @map("school_id") @db.Uuid
  serviceDate DateTime       @map("service_date") @db.Date
  mealType    MealType       @map("meal_type")
  servings    Int
  status      String         @default("DRAFT")
  items       MealPlanItem[]
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([schoolId, serviceDate, mealType])
  @@map("meal_plans")
}

model MealPlanItem {
  id         String   @id @default(uuid()) @db.Uuid
  mealPlanId String   @map("meal_plan_id") @db.Uuid
  dishId     String   @map("dish_id") @db.Uuid
  servings   Int
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dish       Dish     @relation(fields: [dishId], references: [id])

  @@unique([mealPlanId, dishId])
  @@map("meal_plan_items")
}

model FoodSafetyCheck {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  title       String
  category    String
  status      FoodCheckStatus @default(NEEDS_REVIEW)
  checkedAt   DateTime        @default(now()) @map("checked_at")
  checkedById String?         @map("checked_by_id") @db.Uuid
  notes       String?
  evidence    Json?

  @@index([schoolId, checkedAt])
  @@map("food_safety_checks")
}

model TraceEvent {
  id          String         @id @default(uuid()) @db.Uuid
  lotId       String         @map("lot_id") @db.Uuid
  eventType   TraceEventType @map("event_type")
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  actorId     String?        @map("actor_id") @db.Uuid
  location    String?
  description String?
  metadata    Json?
  lot         InventoryLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, occurredAt])
  @@map("trace_events")
}
