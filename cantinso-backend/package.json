{
  "name": "cantinso-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test:units": "tsx --test src/supply/quantity-units.spec.ts",
    "test:stock-vouchers": "tsx --test src/supply/stock-voucher-policy.spec.ts",
    "test:stock-forecast": "tsx --test src/supply/supply-plan.service.spec.ts",
    "test:school-warehouse-access": "tsx --test src/supply/school-warehouse-access.spec.ts",
    "test:supervision-dates": "tsx --test src/supervision/supervision-date-policy.spec.ts",
    "test:supervision-arrival": "tsx --test src/supervision/arrival-receipt.spec.ts",
    "test:supervision-serving": "tsx --test src/supervision/serving-stage-form.spec.ts",
    "test:supervision-stages": "tsx --test src/supervision/stage-responsibility.spec.ts",
    "test:supervision-food": "tsx --test src/supervision/food-safety-forms.spec.ts src/supervision/dispatch-sample-policy.spec.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
